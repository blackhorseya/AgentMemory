{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "amem", "args": ["hook", "claude-code", "user-prompt-submit"], "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "amem", "args": ["hook", "claude-code", "stop"], "timeout": 45 }
        ]
      }
    ]
  }
}
